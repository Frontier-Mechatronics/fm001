{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier:schema:session-v1",
  "title": "Frontier Session Trace v1",
  "description": "A record of one meaningful engineering session: the work attempted, the learning progression, the evidence, the failures, and the ideas that emerged. Vendor-neutral. Written by an agent at explicit user request, reviewed by a human, and thereafter treated as a historical record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "created_at", "title", "project", "repository", "objective"],

  "properties": {
    "schema_version": {
      "const": "session-v1",
      "description": "Identifies the schema this trace claims to conform to. A future session-v2 is a new value, not a redefinition of this one."
    },
    "trace_id": {
      "$ref": "#/$defs/trace_id",
      "description": "Must equal the trace filename without the .json extension."
    },
    "example": {
      "type": "boolean",
      "default": false,
      "description": "True only for synthetic illustrative traces. Consumers building a corpus of real engineering history must exclude these."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the trace was written, not when the work began."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "description": "Concise subject of the session, e.g. 'Linker FLASH overflow caused by orphan section alignment'."
    },
    "summary": {
      "type": "string",
      "description": "A few sentences of plain prose. Optional; the structured fields carry the real content."
    },
    "supersedes": {
      "type": "array",
      "items": { "$ref": "#/$defs/trace_id" },
      "description": "Trace IDs this trace corrects. Superseding is how factual mistakes are fixed; committed traces are not rewritten."
    },

    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "repository_root": { "type": "string", "description": "Absolute or descriptive; not required to be portable." },
        "remote": { "type": "string" },
        "subsystem": { "type": "string", "description": "Optional narrowing, e.g. 'linker', 'power', 'CAN'." }
      }
    },

    "agents": {
      "type": "array",
      "description": "Participants in the session, human and machine. Vendor names appear here as data, never as structure.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "enum": ["assistant", "reviewer", "tool", "human"] },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },

    "repository": {
      "type": "object",
      "description": "Observed repository state. Read this from git rather than from recollection.",
      "additionalProperties": false,
      "properties": {
        "branch": { "type": "string" },
        "head_commit": { "type": "string", "description": "Full or abbreviated SHA as reported by git." },
        "dirty": { "type": "boolean", "description": "True if the working tree had uncommitted changes when the trace was written." },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "untracked_files": { "type": "array", "items": { "type": "string" } },
        "commits_created": {
          "type": "array",
          "description": "Commits made during this session, if any.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha"],
            "properties": {
              "sha": { "type": "string" },
              "subject": { "type": "string" }
            }
          }
        },
        "toolchain": {
          "type": "array",
          "description": "Only tools actually relevant to this session. Not an inventory.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },

    "hardware": {
      "type": "array",
      "description": "Physical items involved. Board and PCB revisions matter: the same firmware behaves differently across them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier"],
        "properties": {
          "identifier": { "type": "string", "description": "e.g. 'NUCLEO-F030R8', 'FM-PWR-A rev B'." },
          "description": { "type": "string" },
          "revision": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },

    "objective": {
      "type": "string",
      "description": "What the session set out to achieve, in the user's terms. Not what was ultimately learned."
    },

    "activities": {
      "type": "array",
      "description": "Significant work performed. Aim for the handful of steps that mattered, not a transcript.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "kind"],
        "properties": {
          "summary": { "type": "string" },
          "kind": { "enum": ["investigation", "implementation", "experiment", "debugging", "documentation", "decision", "measurement", "review", "tooling"] },
          "commands": { "type": "array", "items": { "type": "string" }, "description": "Commands as actually run." },
          "files_changed": { "type": "array", "items": { "type": "string" } },
          "files_inspected": { "type": "array", "items": { "type": "string" } },
          "outcome": { "type": "string" },
          "evidence": { "$ref": "#/$defs/evidence_refs" }
        }
      }
    },

    "learning": {
      "type": "object",
      "description": "The point of the trace. Records how understanding changed, not what the agent explained.",
      "additionalProperties": false,
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question"],
            "properties": {
              "question": { "type": "string" },
              "origin": { "enum": ["user", "agent", "tooling"] },
              "answered": { "type": "boolean" },
              "answer_summary": { "type": "string" },
              "evidence": { "$ref": "#/$defs/evidence_refs" }
            }
          }
        },
        "concepts": {
          "type": "array",
          "description": "Concepts encountered. 'exposure' deliberately has no value meaning 'mastered' — an explanation is not evidence of competence.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "exposure"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "exposure": {
                "enum": ["encountered", "explained", "applied", "verified_by_experiment"],
                "description": "encountered: named only. explained: described in the session. applied: used to make a change. verified_by_experiment: the learner predicted and then observed a result."
              },
              "evidence": { "$ref": "#/$defs/evidence_refs" },
              "notes": { "type": "string" }
            }
          }
        },
        "observations": {
          "type": "array",
          "description": "Things actually seen. Tool output, measurements, document text. Not conclusions drawn from them.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement"],
            "properties": {
              "statement": { "type": "string" },
              "source": { "enum": ["command_output", "hardware_measurement", "document", "code_inspection", "other"] },
              "evidence": { "$ref": "#/$defs/evidence_refs" }
            }
          }
        },
        "model_updates": {
          "type": "array",
          "description": "The central record: what was believed, what was observed, what is now believed. Keep prior_model even when it was wrong, especially when it was wrong.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topic", "prior_model", "observation", "updated_model"],
            "properties": {
              "topic": { "type": "string" },
              "prior_model": { "type": "string", "description": "The belief held before, stated plainly. If it was never explicitly voiced, say so." },
              "observation": { "type": "string", "description": "The evidence that forced the change." },
              "updated_model": { "type": "string" },
              "evidence": { "$ref": "#/$defs/evidence_refs" },
              "confidence": { "$ref": "#/$defs/confidence" },
              "still_uncertain": { "type": "string", "description": "What the update does not settle." }
            }
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question"],
            "properties": {
              "question": { "type": "string" },
              "why_it_matters": { "type": "string" },
              "blocked_on": { "type": "string" },
              "evidence": { "$ref": "#/$defs/evidence_refs" }
            }
          }
        },
        "misconceptions": {
          "type": "array",
          "description": "Wrong beliefs surfaced during the session, whether the user's, the agent's, or both. These are valuable; do not omit them out of tidiness.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["misconception", "held_by"],
            "properties": {
              "misconception": { "type": "string" },
              "held_by": { "enum": ["user", "agent", "both", "unknown"] },
              "corrected": { "type": "boolean" },
              "correction": { "type": "string" },
              "evidence": { "$ref": "#/$defs/evidence_refs" }
            }
          }
        }
      }
    },

    "experiments": {
      "type": "array",
      "description": "Deliberate attempts to answer a question by doing something and observing the result.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/local_id" },
          "question": { "type": "string" },
          "method": { "type": "string" },
          "commands": { "type": "array", "items": { "type": "string" } },
          "predicted_result": { "type": "string", "description": "What was expected beforehand. Recording this is what makes the experiment informative rather than decorative." },
          "observed_result": { "type": "string" },
          "conclusion": { "type": "string" },
          "status": { "enum": ["completed", "inconclusive", "abandoned", "planned"] },
          "evidence": { "$ref": "#/$defs/evidence_refs" }
        }
      }
    },

    "failures": {
      "type": "array",
      "description": "First-class records. Wrong turns and rejected hypotheses are retained deliberately.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observed", "resolved"],
        "properties": {
          "id": { "$ref": "#/$defs/local_id" },
          "observed": { "type": "string", "description": "The failure as it presented, ideally quoting the actual error text." },
          "hypotheses": {
            "type": "array",
            "description": "Including the ones that turned out to be wrong.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["statement", "status"],
              "properties": {
                "statement": { "type": "string" },
                "status": { "enum": ["rejected", "supported", "untested"] },
                "reason": { "type": "string" }
              }
            }
          },
          "diagnostics": { "type": "array", "items": { "type": "string" }, "description": "Steps taken to narrow it down, in order." },
          "root_cause": { "type": "string" },
          "resolution": { "type": "string" },
          "resolved": { "type": "boolean" },
          "evidence": { "$ref": "#/$defs/evidence_refs" },
          "pedagogical_value": { "type": "string", "description": "Why a future learner would benefit from meeting this failure. Empty is acceptable; invented significance is not." }
        }
      }
    },

    "claims": {
      "type": "array",
      "description": "Load-bearing statements from the session, each tagged with how well it is actually supported. This is the guard against agent speculation hardening into project fact.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/local_id" },
          "statement": { "type": "string" },
          "status": {
            "enum": ["observed", "inferred", "hypothesis", "unresolved"],
            "description": "observed: seen directly in output, a measurement, or a primary document. inferred: reasoned from observations. hypothesis: plausible, untested. unresolved: contested or unknown."
          },
          "confidence": { "$ref": "#/$defs/confidence" },
          "evidence": { "$ref": "#/$defs/evidence_refs" },
          "verification_required": { "type": "string", "description": "What would settle it. Required whenever status is not 'observed'." }
        },
        "allOf": [
          {
            "$comment": "A claim that is not directly observed must say what would settle it.",
            "if": {
              "required": ["status"],
              "properties": { "status": { "enum": ["inferred", "hypothesis", "unresolved"] } }
            },
            "then": { "required": ["verification_required"] }
          }
        ]
      }
    },

    "evidence": {
      "type": "array",
      "description": "Registry of artifacts referenced elsewhere in the trace by id. Store references, never embedded artifacts.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "ref"],
        "properties": {
          "id": { "$ref": "#/$defs/local_id" },
          "type": {
            "enum": [
              "file", "directory", "commit", "diff", "command", "command_output", "log",
              "binary", "elf", "linker_script", "map_file", "debugger_output",
              "saleae_capture", "scope_capture", "measurement", "photo",
              "schematic", "pcb_revision", "board_revision", "hardware_id",
              "document", "datasheet", "url", "other"
            ]
          },
          "ref": { "type": "string", "description": "Repository-relative path where possible; otherwise a descriptive reference such as a document ID and revision. Absolute machine-specific paths age badly." },
          "description": { "type": "string" },
          "revision": { "type": "string", "description": "Document revision, board revision, or similar." },
          "location": { "type": "string", "description": "Where within the artifact, e.g. 'page 39/775', 'line 25', 'channel 2, 4.2 ms'." },
          "captured_at": { "type": "string", "format": "date-time" }
        }
      }
    },

    "future_work": {
      "type": "object",
      "description": "Ideas that emerged naturally from the work. Source capture only: a session trace never contains course material itself.",
      "additionalProperties": false,
      "properties": {
        "experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["idea"],
            "properties": {
              "idea": { "type": "string" },
              "rationale": { "type": "string" },
              "prerequisites": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "course_topics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topic"],
            "properties": {
              "topic": { "type": "string" },
              "rationale": { "type": "string" },
              "level": { "enum": ["foundation", "intermediate", "advanced"] },
              "related_concepts": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exercise"],
            "properties": {
              "exercise": { "type": "string" },
              "rationale": { "type": "string" },
              "verification": { "type": "string", "description": "How a learner would know they succeeded." }
            }
          }
        },
        "useful_failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["why_useful"],
            "properties": {
              "failure_id": { "$ref": "#/$defs/local_id", "description": "Reference to an entry in this trace's failures array." },
              "description": { "type": "string" },
              "why_useful": { "type": "string" }
            }
          }
        },
        "likely_misconceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["misconception"],
            "properties": {
              "misconception": { "type": "string" },
              "why_likely": { "type": "string" }
            }
          }
        },
        "useful_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["why_useful"],
            "properties": {
              "evidence_id": { "$ref": "#/$defs/local_id" },
              "description": { "type": "string" },
              "why_useful": { "type": "string" }
            }
          }
        },
        "prerequisites": {
          "type": "array",
          "description": "Ordering relationships noticed during the work, e.g. understanding X was needed before Y made sense.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["concept", "requires"],
            "properties": {
              "concept": { "type": "string" },
              "requires": { "type": "array", "items": { "type": "string" } },
              "noticed_how": { "type": "string" }
            }
          }
        }
      }
    },

    "notes": {
      "type": "string",
      "description": "Anything the structure does not accommodate. Keep short; recurring use here is a signal the schema needs a v2 field."
    }
  },

  "$defs": {
    "trace_id": {
      "type": "string",
      "pattern": "^(EXAMPLE-)?[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}-[a-z0-9][a-z0-9-]*$",
      "description": "YYYY-MM-DDTHHMMSS-short-topic, optionally prefixed EXAMPLE- for synthetic traces."
    },
    "local_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Identifier unique within this trace. Short and readable, e.g. 'ev-map-file', 'fail-flash-overflow'."
    },
    "confidence": {
      "enum": ["low", "medium", "high"],
      "description": "How much weight this should carry later. Absent means unstated, which is different from low."
    },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/local_id" },
      "description": "IDs of entries in the top-level evidence array."
    }
  }
}
